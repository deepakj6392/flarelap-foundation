{
  "name": "flarelap-global-foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "cross-env DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/flarelap_db?sslmode=disable\" next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push:local": "cross-env DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/flarelap_db?sslmode=disable\" prisma db push",
    "seed:gallery": "node prisma/seeds/gallery.seed.js",
    "seed:teams": "node prisma/seeds/teams.seed.js",
    "seed:blogs": "node prisma/seeds/blogs.seed.js",
    "seed:categories": "node prisma/seeds/categories.seed.js",
    "seed:courses": "node prisma/seeds/courses.seed.js",
    "seed:test-series": "node prisma/seeds/test-series.seed.js",
    "seed:mcqs": "node prisma/seeds/mcqs.seed.js",
    "seed:settings": "node prisma/seeds/settings.seed.js",
    "seed:all": "npm run seed:settings && npm run seed:gallery && npm run seed:teams && npm run seed:blogs && npm run seed:categories && npm run seed:courses && npm run seed:test-series && npm run seed:mcqs",
    "seed:all:local": "cross-env DATABASE_URL=\"postgresql://postgres:postgres@localhost:5432/flarelap_db?sslmode=disable\" npm run seed:all"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.18.0",
    "next": "16.2.7",
    "nodemailer": "^8.0.11",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.2",
    "sweetalert2": "^11.26.25",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
